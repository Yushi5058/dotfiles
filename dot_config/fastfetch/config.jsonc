{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$HOME/.config/fastfetch/panda.txt",
        "type": "file",
        "padding": {
            "top": 2,
            "left": 2
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "disk",
            "key": "└ └",
            "keyColor": "#8fbcbb"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "#ebcb8b"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "#ebcb8b"
        },
        {
            "type": "bios",
            "key": "│ ├",
            "keyColor": "#ebcb8b"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "#ebcb8b"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "#ebcb8b"
        },
        "break",
        {
            "type": "de",
            "key": " DE",
            "keyColor": "#88c0d0"
        },
        {
            "type": "lm",
            "key": "│ ├",
            "keyColor": "#88c0d0"
        },
        {
            "type": "wm",
            "key": "│ ├",
            "keyColor": "#88c0d0"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉼",
            "keyColor": "#88c0d0"
        },
        {
            "type": "terminal",
            "key": "└ └",
            "keyColor": "#88c0d0"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────Uptime / Age / DT────────────────────┐"
        },
        {
            "type": "command",
            "key": "  OS Age ",
            "keyColor": "#b48ead",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "#b48ead"
        },
        {
            "type": "datetime",
            "key": "  DateTime ",
            "keyColor": "#b48ead"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
        },
        //        {
        //            "type": "colors"
        //        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
