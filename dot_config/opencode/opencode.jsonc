{
  "$schema": "https://opencode.ai/config.json",

  // Nord palette
  // base: #2e3440  surface: #3b4252  overlay: #434c5e
  // muted: #4c566a  text: #d8dee9
  // love: #bf616a  gold: #ebcb8b  rose: #d08770
  // pine: #8fbcbb  foam: #88c0d0  iris: #b48ead

  // OpenCode V2 plugins (npm packages are fetched by opencode on demand)
  // Discord Rich Presence, V2-compatible fork: github.com/Yushi5058/opencode-discord-presence
  "plugins": ["@yushi_61/opencode-discord-presence"],

  "agent": {
    "build":  { "color": "#bf616a" },
    "plan":   { "color": "#ebcb8b" },
    "general": { "color": "#88c0d0" },
    "explore": { "color": "#8fbcbb" }
  }
}
