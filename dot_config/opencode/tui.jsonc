{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "rose-pine-moon",
  "scroll_speed": 3,
  "scroll_acceleration": { "enabled": true },
  "diff_style": "auto",
  "cursor": { "style": "block", "blinking": true },
  "mouse": true,
  "attention": { "enabled": true, "notifications": true, "sound": true, "volume": 0.4 },
  "keybinds": {
    "command_list": "ctrl+p",
    "agent_list": "ctrl+a",
    "model_list": "ctrl+m",
    "theme_list": "ctrl+t"
  }
}