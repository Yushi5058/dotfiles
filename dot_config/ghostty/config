# Ghostty Config - Rosé Pine Moon Theme

# Font
font-family = Maple Mono
font-size = 16

# Theme - Rosé Pine Moon
background = #232136
foreground = #e0def4
cursor-color = #c4a7e7
cursor-style = block

# Selection
selection-background = #3e8fb0
selection-foreground = #232136

# Window
background-opacity = 0.65
window-padding-x = 10
window-padding-y = 10


# Mouse
# Selection fills only the Linux PRIMARY buffer (middle-click paste). The system
# clipboard (Ctrl+Shift+C / Ctrl+Shift+V) changes only on an explicit copy.
copy-on-select = primary
