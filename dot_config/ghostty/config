# Ghostty Config - Nord Theme

# Font
font-family = Maple Mono
font-size = 16

# Theme - Nord
background = #2e3440
foreground = #d8dee9
cursor-color = #88c0d0
cursor-style = block

# Selection
selection-background = #5e81ac
selection-foreground = #eceff4

# Window
background-opacity = 0.95
window-padding-x = 10
window-padding-y = 10


# Mouse
# Every selection fills both the system clipboard and PRIMARY, so Ctrl+V works
# right after selecting text and middle-click still pastes. Explicit copy
# (Ctrl+Shift+C) still works.
copy-on-select = both
