#!/bin/bash
# First-apply bootstrap: install all packages via the declarative lists.
# Delegates to scripts/sync-packages.sh (single source of truth).
# Requires sudo privileges (interactive TTY for the first run).

if [ "$(id -u)" -eq 0 ]; then
    echo "[-] This script should not be run as root"
    exit 1
fi

SOURCE_DIR={{ .chezmoi.sourceDir | quote }}

if [ -x "$SOURCE_DIR/scripts/sync-packages.sh" ]; then
    exec "$SOURCE_DIR/scripts/sync-packages.sh"
else
    echo "[-] scripts/sync-packages.sh not found in $SOURCE_DIR"
    echo "    Expected layout: dot_config/packages/{base,aur}.txt + scripts/sync-packages.sh"
    exit 1
fi