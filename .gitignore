# neovim
dot_config/nvim/lazy-lock.json

# librewolf - only track config files, ignore profile data
# Tracked: .keep (empty_dot_keep), librewolf.overrides.cfg, ublock-backup.json
dot_librewolf/*/
dot_librewolf/installs.ini
dot_librewolf/profiles.ini

# tmux plugins - loaded via tpm
dot_config/tmux/plugins/

# chezmoi - ignore config file (machine-specific)
.config/chezmoi/
